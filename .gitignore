# IEX_SLS — .gitignore
# Patterns with **/ match at any directory depth

# Python cache
**/__pycache__/
*.pyc
*.pyo

# RINGS software (binary, not ours)
rings-code-v1.3.5/

# Cluster job logs (auto-generated)
**/cluster_logs/

# LAMMPS trajectory files (GB each)
*.lammpstrj
*.lammpsdump

# LAMMPS simulation output directories inside STAGE*
**/STAGE*/data/
**/STAGE*/trajectories/
**/STAGE*/logs/
**/STAGE*/restarts/
**/STAGE*/results/
**/test_run/

# RINGS computed data (thousands of files per composition)
**/GR_CN_RINGS/AM_x*/
**/GR_CN_RINGS/AM300K_x*/
**/GR_CN_RINGS/IEX1_x*/
**/GR_CN_RINGS/IEX2_x*/
**/GR_CN_RINGS/REIEX1_x*/
**/GR_CN_RINGS/REIEX2_x*/

# LAMMPS log files
*.lammps
log.lammps

# Grace/xmgrace
*.agr

# Bond angle per-composition data (regenerable)
**/BOND_ANGLE_DIST/data/
**/BOND_ANGLE_DIST/bonds/

# Test and misc heavy directories
1500_atoms/
youngs_modulus_stress_strain/

# Compiler artifacts
*.o
*.err
