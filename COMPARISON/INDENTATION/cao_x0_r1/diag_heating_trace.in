# diag_heating_trace.in
# Mismo protocolo que relax_surface.in (warmup + heating 300->1600K +
# cooling 1600->300K + equilibracion final), pero SOBRE slab.dat (29000
# atomos, SIN la replica lateral 3x3 -- el fenomeno de expansion/dispersion
# en z no depende de cuantas veces se repita lateralmente, asi que corre
# ~9x mas rapido) y con un DUMP periodico de posiciones para rastrear la
# evolucion temporal de la distribucion en z durante todo el ciclo.

units           metal
dimension       3
boundary        p p f
processors      * * 1
atom_style      charge
atom_modify     map yes
newton          on

read_data       slab.dat

mass 1 28.086
mass 2 15.9994
mass 3 40.078
mass 4 22.99
mass 5 39.10

pair_style      hybrid/overlay pedone 8.0 coul/long 12.0

pair_coeff      * * coul/long

pair_coeff      1 2 pedone 0.340554 2.006700 2.100000  1.0
pair_coeff      2 2 pedone 0.042395 1.379316 3.618701 22.0
pair_coeff      2 3 pedone 0.030211 2.241334 2.923245  5.0
pair_coeff      2 4 pedone 0.023363 1.763867 3.006315  5.0
pair_coeff      2 5 pedone 0.011612 2.062605 3.305308  5.0

kspace_style    pppm 1.0e-4
kspace_modify   slab 3.0

group           glass_atoms type 1 2 3 4 5
region          bottom block INF INF INF INF INF 20.0 units box
group           bottom_glass region bottom
group           mobile subtract glass_atoms bottom_glass

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
timestep        0.001

thermo          2000
thermo_style    custom step temp etotal pe press density
thermo_modify   lost warn

fix             freeze bottom_glass move linear 0.0 0.0 0.0 units box
fix             wall_top mobile wall/reflect zhi 250.0
fix             wall_bottom mobile wall/reflect zlo 20.0

# --- DUMP: posiciones cada 5000 pasos, todo el ciclo ---
dump            trace all custom 5000 heating_trace.lammpstrj id type x y z
dump_modify     trace sort id

velocity        mobile create 300.0 12345 mom yes rot yes dist gaussian
fix             warmup mobile nve/limit 0.01
run             2000
unfix           warmup

print "### HEATING 300->1600K ###"
fix             1 mobile nvt temp 300.0 1600.0 0.1
run             260000
unfix           1

print "### COOLING 1600->300K ###"
fix             2 mobile nvt temp 1600.0 300.0 0.1
run             260000
unfix           2

print "### EQUILIBRATING at 300K (400 ps) ###"
fix             3 mobile nvt temp 300.0 300.0 0.1
run             400000
unfix           3

unfix           freeze
unfix           wall_top
unfix           wall_bottom

write_data      diag_slab_relaxed.data nocoeff

print "DIAG HEATING TRACE DONE"
