# fix_atom_types.in — repara slab_2x2_relaxed.data para reservar el tipo 6 (C)
# necesario para create_atoms en create_slab_tip.in, sin re-correr la fisica.

units           metal
dimension       3
boundary        p p f
atom_style      charge
atom_modify     map yes

read_data       slab_2x2_relaxed.data extra/atom/types 1

mass 6 12.011

write_data      slab_2x2_relaxed.data nocoeff

print "Reparado: slab_2x2_relaxed.data ahora declara 6 atom types"
