# indent_test.in — prueba rápida de 500+200 pasos para verificar potenciales

echo            both
units           metal
dimension       3
boundary        p p f
atom_style      charge
atom_modify     map yes
newton          on

read_data       slab2x2_tip.data

mass 1 28.086
mass 2 15.9994
mass 3 40.078
mass 4 22.99
mass 5 39.10
mass 6 12.011

set type 1 charge  2.4
set type 2 charge -1.2
set type 3 charge  1.2
set type 4 charge  0.6
set type 5 charge  0.6
# tipo 6 (C): carga 0 ya asignada en create_slab_tip.in

pair_style      hybrid/overlay pedone 8.0 coul/long 12.0 tersoff buck 10.0

pair_coeff      * * coul/long

pair_coeff      1 2 pedone 0.340554 2.006700 2.100000  1.0
pair_coeff      2 2 pedone 0.042395 1.379316 3.618701 22.0
pair_coeff      2 3 pedone 0.030211 2.241334 2.923245  5.0
pair_coeff      2 4 pedone 0.023363 1.763867 3.006315  5.0
pair_coeff      2 5 pedone 0.011612 2.062605 3.305308  5.0

pair_coeff      * * tersoff /home/alfredo/.local/share/lammps/potentials/SiC.tersoff NULL NULL NULL NULL NULL C

pair_coeff      1 6 buck 1000.0 0.25 0.0
pair_coeff      2 6 buck 1000.0 0.25 0.0
pair_coeff      3 6 buck 1000.0 0.25 0.0
pair_coeff      4 6 buck 1000.0 0.25 0.0
pair_coeff      5 6 buck 1000.0 0.25 0.0

kspace_style    pppm 1.0e-4
kspace_modify   slab 3.0

group           glass  type 1 2 3 4 5
group           tip    type 6

region          bottom block INF INF INF INF INF 20.0 units box
group           bottom_glass region bottom
group           mobile subtract glass bottom_glass

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
timestep        0.001

compute         fz_tip tip reduce sum fz
variable        fz     equal c_fz_tip
compute         tipz   tip reduce ave z
variable        zpos   equal c_tipz

thermo          100
thermo_style    custom step temp etotal pe press

# Equilibración: 500 pasos
fix             freeze bottom_glass move linear 0.0 0.0 0.0 units box
fix             nvt_eq mobile nvt temp 300 300 0.1
run             500
unfix           nvt_eq

# Carga: 200 pasos (0.1 Å de penetración)
fix             nvt_ind mobile nvt temp 300 300 0.1
fix             IndentForce all ave/time 10 1 100 v_fz v_zpos file tip_force_test.dat
fix             loading tip move linear 0.0 0.0 -0.5 units box
run             200
unfix           loading

print "TEST OK — potenciales cargados, dinamica sin errores"
print "z_tip final = ${zpos} A    Fz = ${fz} eV/A"
