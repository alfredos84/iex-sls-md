# create_slab_tip.in
# Lee slab_2x2_relaxed.data (ya replicado 3x3 y con superficie reconstruida
# termicamente) y agrega la punta conica de carbono (tipo 6).
#
# Tipos resultantes: Si=1, O=2, Ca=3, Na=4, K=5, C(tip)=6
# Geometria punta: cono Berkovich equivalente, angulo semi-apical 37.3
#   radio base = 40 A, altura = 52.5 A
#   apice en z_apex = zsurf_real + 5.0 A (calculado, no fijo)

units           metal
dimension       3
boundary        p p f
atom_style      charge
atom_modify     map yes

read_data       slab_2x2_relaxed.data

# Centro de la caja en x,y
variable xmid   equal xlo+0.5*lx
variable ymid   equal ylo+0.5*ly

# Superficie real del vidrio tras la reconstruccion termica (puede haber
# variado levemente respecto a los ~57.65 A originales)
group           glass_atoms type 1 2 3 4 5
variable zsurf  equal bound(glass_atoms,zmax)
variable zapex  equal ${zsurf}+5.0
variable zbase  equal ${zapex}+52.5

variable tip_r  equal 40.0      # radio de la base (A)

# Crear atomos de C en la region conica (tipo 6)
lattice         diamond 3.567
region          tip_cone cone z ${xmid} ${ymid} 0.0 ${tip_r} ${zapex} ${zbase} units box
create_atoms    6 region tip_cone
mass            6 12.011
set             type 6 charge 0.0

write_data      slab2x2_tip.data nocoeff

print "Escrito: slab2x2_tip.data"
print "  Vidrio: 58000 atomos (tipos 1-5), superficie reconstruida"
print "  Punta C: tipo 6, zsurf=${zsurf} apice en z=${zapex} A"
