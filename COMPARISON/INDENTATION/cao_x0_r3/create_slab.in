# create_slab.in
# Lee la caja bulk AM (p p p), la duplica en z (mismo metodo que Pedone usa
# para crecer lateralmente: replicar una celda ya equilibrada -- Pedone no
# lo necesita en z porque arranca de un bulk ~103 A de lado (80000 atomos);
# el nuestro es ~58 A / 14500 atomos, asi que replicamos en z para llegar a
# profundidad de vidrio comparable), y despues extiende z para crear la
# superficie libre. Escribe slab.dat.
# Átomo types: Si=1, O=2, Ca=3, Na=4, K=5, C=6 (reservado, sin atomos aun)
#
# Caja bulk: ~57.65 Å cúbica -> tras "replicate 1 1 2": ~115.3 Å de vidrio.
# Motivo: con el fondo congelado (20 A) y hmax~37 A de penetracion, la
# profundidad libre original (~42 A) dejaba el sustrato rigido demasiado
# cerca del contacto (~1.14x hmax) e inflaba la rigidez de contacto medida
# muy por encima de la elasticidad real del material (E=71 GPa, medido en
# bulk vs STAGE2_ELASTIC_T0). Con ~115 A de vidrio, la profundidad libre
# sube a ~95 A (~2.6x hmax), mas consistente con la practica de Pedone
# (bulk ~103 A, profundidad libre ~83 A tras el fondo fijo).
#
# Vacio en AMBOS lados (no solo arriba), igual que el slab.dat real de
# Pedone (verificado directamente: su caja va de z=-52.14 a 196.98, con el
# vidrio en z=[0.14,104.70] -- vacio real abajo Y arriba, no un corte del
# bulk pegado al borde de la caja). Adaptado a nuestra celda (mas chica),
# no a los numeros exactos de Pedone: 60 A abajo (solo hace falta desacoplar
# imagenes periodicas, cutoffs 8-12 A) y 324 A arriba (>=2-3x el espesor del
# vidrio para kspace_modify slab, mas lugar de sobra para la punta despues).

units           metal
dimension       3
boundary        p p p
atom_style      charge
atom_modify     map yes

# extra/atom/types 1: reserva el tipo 6 (C, punta) desde el arranque, para
# que create_atoms funcione mas adelante sin editar el header a mano.
read_data       ../../../75SiO2_15-xNa2O_xK2O_10CaO/STAGE1_MELTQUENCH/data/asmelted_723K/AsMelted_723K_x0_r3_PMMCS_rc8p0.data extra/atom/types 1

mass 6 12.011

# Duplicar en z MIENTRAS la celda sigue totalmente periodica (p p p, ver
# arriba) -- replicar en una dimension ya marcada "f" (no periodica) da
# "WARNING: Replicating in a non-periodic dimension" y no garantiza que la
# nueva interfase entre copias sea fisicamente continua. Recien despues de
# este replicate pasamos a p p f (abajo, en change_box).
replicate       1 1 2

# Extender la caja en z EN AMBOS LADOS para crear dos superficies libres
# (conserva las posiciones atómicas -- el vidrio queda "en el medio")
change_box all z final -60.0 440.0 boundary p p f units box

write_data      slab.dat nocoeff

print "Slab escrito: slab.dat  (~115 A de vidrio, vacio abajo=60 A, arriba=324 A)"
