# STAGE10 TEST — x=6, r=1, T=800+1000 K only, runs cortos (10+50 ps)
# Verifica: lectura de estructura, potencial, grupos, MSD, output

echo            both
units           metal
dimension       3
boundary        p p p
atom_style      charge
atom_modify     map yes
newton          on

read_data       ${datafile}
log             data/stage10_test_x${val_x}_r${val_r}.lammps

include         ${potfile}
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

group Na type 4
group K  type 5

timestep        0.002

thermo          500
thermo_style    custom step time temp press pe ke etotal vol density
thermo_modify   norm no

variable Pbar  equal 1.0
variable Tdamp equal 0.2
variable Pdamp equal 2.0

# Tiempos cortos solo para test:
#   eq    = 10 ps  →   5 000 steps
#   prod  = 50 ps  →  25 000 steps
variable eq_steps equal 5000
variable pr_steps equal 25000

variable thisT index 800 1000
variable prevT equal 300.0

label loop_T

    print "=== TEST: T=${thisT} K ==="
    reset_timestep 0

    variable ramp_steps equal ceil((${thisT}-${prevT})/(1.0*0.002))
    fix rampNPT all npt temp ${prevT} ${thisT} ${Tdamp} iso ${Pbar} ${Pbar} ${Pdamp}
    run ${ramp_steps}
    unfix rampNPT
    reset_timestep 0

    fix eqNPT all npt temp ${thisT} ${thisT} ${Tdamp} iso ${Pbar} ${Pbar} ${Pdamp}
    run ${eq_steps}
    unfix eqNPT
    reset_timestep 0

    compute msdNa Na msd com yes
    compute msdK  K  msd com yes

    fix msdNaOut all ave/time 1000 1 1000 &
        c_msdNa[1] c_msdNa[2] c_msdNa[3] c_msdNa[4] &
        file data/msd_Na_${thisT}K_x${val_x}_r${val_r}.dat

    fix msdKOut all ave/time 1000 1 1000 &
        c_msdK[1] c_msdK[2] c_msdK[3] c_msdK[4] &
        file data/msd_K_${thisT}K_x${val_x}_r${val_r}.dat

    fix prodNPT all npt temp ${thisT} ${thisT} ${Tdamp} iso ${Pbar} ${Pbar} ${Pdamp}
    run ${pr_steps}

    unfix prodNPT
    unfix msdNaOut
    unfix msdKOut
    uncompute msdNa
    uncompute msdK

    variable prevT equal ${thisT}

next thisT
jump SELF loop_T

print "TEST COMPLETE"
