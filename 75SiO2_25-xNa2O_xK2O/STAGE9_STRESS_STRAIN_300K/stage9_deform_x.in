# STAGE9 — PMMCS rc8p0 — Uniaxial deformation along X at 300K
# erate = 1e9 s^-1 = 1e-3 ps^-1, strain_max = 0.10 (10%)
# Input variables (command line):
#   val_datafile   full path to input .data file (from STAGE7)
#   val_tag        unique run ID (e.g. AM300K_x6_r2, IEX1_300K_xt3_r1)
#   val_seed       velocity seed (r=1:42345, r=2:22345, r=3:33345)
#   potfile        path to potential mod file

units           metal
boundary        p p p
atom_style      charge
atom_modify     map yes
newton          on

read_data       ${val_datafile}
velocity        all create 300.0 ${val_seed} mom yes rot no dist gaussian

log             logs/stage9_x_${val_tag}.lammps

include         ${potfile}
neighbor        1.0 bin

compute totalpressure all pressure thermo_temp

thermo          5000
thermo_style    custom step etotal temp pe press pxx pyy pzz vol density lx ly lz
thermo_modify   norm no

timestep        0.001

variable        strain_rate_s  equal 1.0e9
variable        strain_max     equal 0.10
variable        erate          equal v_strain_rate_s*1.0e-12
variable        deform_steps   equal ceil(v_strain_max/(v_erate*dt))
variable        print_freq     equal 1000

################################################################################
# Short NPT relaxation at 300K before deformation
reset_timestep  0
fix RELAXNPT all npt temp 300.0 300.0 $(100.0*dt) iso 0.0 0.0 $(1000.0*dt)
run             10000
unfix RELAXNPT

reset_timestep  0

################################################################################
# Uniaxial deformation: x direction, y and z at 0 pressure
variable        L0x          equal $(lx)
variable        L0y          equal $(ly)
variable        L0z          equal $(lz)
variable        mech_strain  equal (lx-v_L0x)/v_L0x
variable        strain_y     equal (ly-v_L0y)/v_L0y
variable        strain_z     equal (lz-v_L0z)/v_L0z
variable        poisson_xy   equal -v_strain_y/v_mech_strain
variable        poisson_xz   equal -v_strain_z/v_mech_strain
variable        stress_x     equal -pxx/10000.0
variable        stress_y     equal -pyy/10000.0
variable        stress_z     equal -pzz/10000.0

thermo          ${print_freq}
thermo_style    custom step v_mech_strain v_strain_y v_strain_z &
                v_poisson_xy v_poisson_xz temp v_stress_x v_stress_y v_stress_z &
                pe press vol density lx ly lz

fix DEFORMATION all deform 1 x erate ${erate} units box remap x
fix INTEGNPT    all npt temp 300.0 300.0 $(100.0*dt) &
                y 0.0 0.0 $(1000.0*dt) z 0.0 0.0 $(1000.0*dt) drag 1.0
fix STRESS_STRAIN all print ${print_freq} &
    "${mech_strain} ${strain_y} ${strain_z} ${poisson_xy} ${poisson_xz} ${stress_x} ${stress_y} ${stress_z}" &
    file results/ss_x_${val_tag}.dat screen no &
    title "strain_x strain_y strain_z poisson_xy poisson_xz stress_x_GPa stress_y_GPa stress_z_GPa"

run ${deform_steps}

unfix DEFORMATION
unfix INTEGNPT
unfix STRESS_STRAIN

print "DONE stage9_x ${val_tag}: strain_final=$(v_mech_strain) stress_x=$(v_stress_x) GPa"
