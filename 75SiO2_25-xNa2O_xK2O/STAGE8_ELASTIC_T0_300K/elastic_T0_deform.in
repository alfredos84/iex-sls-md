# STAGE8 — PMMCS rc8p0 — one strain perturbation for elastic tensor (T=0 K)
# 300K-quenched glasses. Each of the 12 perturbations is a separate LAMMPS run.
# Input variables (command line):
#   val_tag        unique run ID (must match the ref run)
#   potfile        path to potential mod file
#   strain_up      finite strain magnitude (e.g. 5e-4)
#   val_dir        Voigt direction (1=xx,2=yy,3=zz,4=yz,5=xz,6=xy)
#   val_sign       +1 or -1

read_restart    results/restart.elastic_T0_${val_tag}

log             results/elastic_T0_deform_${val_tag}_dir${val_dir}_sign${val_sign}.lammps

change_box      all triclinic
include         ${potfile}
neighbor        1.0 bin
neigh_modify    once no every 1 delay 0 check yes

thermo          10
thermo_style    custom step temp pe press pxx pyy pzz pxy pxz pyz vol lx ly lz
thermo_modify   norm no

min_style       cg
min_modify      dmax 1.0e-2 line quadratic

variable        up   equal ${strain_up}

if "${val_dir} == 1" then "variable len0 equal $(lx)"
if "${val_dir} == 2" then "variable len0 equal $(ly)"
if "${val_dir} == 3" then "variable len0 equal $(lz)"
if "${val_dir} == 4" then "variable len0 equal $(lz)"
if "${val_dir} == 5" then "variable len0 equal $(lz)"
if "${val_dir} == 6" then "variable len0 equal $(ly)"

variable        delta   equal ${val_sign}*${up}*${len0}
variable        deltaxy equal ${val_sign}*${up}*xy
variable        deltaxz equal ${val_sign}*${up}*xz
variable        deltayz equal ${val_sign}*${up}*yz

if "${val_dir} == 1" then &
   "change_box all x delta 0 ${delta} xy delta ${deltaxy} xz delta ${deltaxz} remap units box"
if "${val_dir} == 2" then &
   "change_box all y delta 0 ${delta} yz delta ${deltayz} remap units box"
if "${val_dir} == 3" then &
   "change_box all z delta 0 ${delta} remap units box"
if "${val_dir} == 4" then &
   "change_box all yz delta ${delta} remap units box"
if "${val_dir} == 5" then &
   "change_box all xz delta ${delta} remap units box"
if "${val_dir} == 6" then &
   "change_box all xy delta ${delta} remap units box"

minimize        0.0 1.0e-10 10000 100000

print "$(pxx) $(pyy) $(pzz) $(pxy) $(pxz) $(pyz) ${len0} ${delta}" &
      file results/elastic_T0_stress_${val_tag}_dir${val_dir}_sign${val_sign}.txt screen yes

print "DEFORM DONE ${val_tag} dir=${val_dir} sign=${val_sign}"
