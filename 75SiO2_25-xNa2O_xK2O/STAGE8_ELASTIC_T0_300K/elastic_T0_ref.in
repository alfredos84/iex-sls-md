# STAGE8 — PMMCS rc8p0 — reference minimize for elastic tensor (T=0 K)
# Starting from 300K-quenched glasses (STAGE7 output).
# Minimizes with anisotropic box relax to zero-stress reference state.
# Input variables (command line):
#   val_datafile   full path to input .data file (from STAGE7)
#   val_tag        unique run ID (e.g. AM300K_x6_r2, IEX1_300K_xt3_r1, IEX2_300K_xp0_r3)
#   potfile        path to potential mod file

units           metal
boundary        p p p
atom_style      charge
atom_modify     map yes
newton          on

read_data       ${val_datafile}

log             results/elastic_T0_ref_${val_tag}.lammps

include         ${potfile}
neighbor        1.0 bin
neigh_modify    once no every 1 delay 0 check yes

thermo          10
thermo_style    custom step temp pe press pxx pyy pzz pxy pxz pyz vol lx ly lz
thermo_modify   norm no

min_style       cg
min_modify      dmax 1.0e-2 line quadratic

fix             BOXRELAX all box/relax aniso 0.0 vmax 0.001
minimize        0.0 1.0e-10 10000 100000
unfix           BOXRELAX

write_restart   results/restart.elastic_T0_${val_tag}

print "$(pxx) $(pyy) $(pzz) $(pxy) $(pxz) $(pyz) $(lx) $(ly) $(lz)" &
      file results/elastic_T0_ref_${val_tag}.txt screen yes

print "REFERENCE DONE ${val_tag}  press=$(press) bar  lx=$(lx) ly=$(ly) lz=$(lz) Ang"
