# STAGE11_REVERSE_IEX1 — Reverse Ion-exchange of Proto1, PMMCS rc8p0
#
# Tests whether IEX Proto1 is elastic: if the glass returns to the
# as-melted (x=0) structure after re-substituting K→Na at the same sites.
#
# IEX Proto1 always starts from AM x=0 (zero native K), so EVERY K
# present in the IOX1 data file originated from a Na atom.
# Reverse is therefore instantaneous: set type 5→4 (all K→Na).
#
# Protocol (mirrors STAGE3):
#   1. read_data IOX1_723K
#   2. ALL K→Na instantaneous substitution — no minimization
#   3. NVT 4000 ps at 723 K — local rearrangement at fixed volume (10 frames)
#   4. NPT 6000 ps at 723 K — full volume relaxation (10 frames)
#   5. write_data REIEX1_723K
#
# Required -var:
#   val_x_target   target K2O mol% that was used in STAGE3 (1, 3, 6, 9, 12, 15)
#   val_r          replica index (1, 2, 3)
#   potfile        path to PMMCS .mod file

echo            both
units           metal
dimension       3
boundary        p p p
atom_style      charge
atom_modify     map yes
newton          on

variable        x_target equal ${val_x_target}
variable        r        equal ${val_r}
variable        dt       equal 0.001

variable        seed_vel equal 85000+v_x_target*100+v_r*10

variable        dump_nvt equal round(400.0/v_dt)    # 10 frames over 4000 ps
variable        dump_npt equal round(600.0/v_dt)    # 10 frames over 6000 ps

shell mkdir -p data/rev_iex1_723K logs trajectories

log logs/stage11_xt${x_target}_r${r}_PMMCS_rc8p0.lammps

read_data       ../STAGE3_IEX_PROTO1/data/iox1_723K/IOX1_723K_xt${x_target}_r${r}_PMMCS_rc8p0.data

include         ${potfile}

neighbor        2.0 bin
neigh_modify    delay 0 check yes every 1

################################################################################
# 1. Instantaneous K→Na back-substitution — no minimization
################################################################################

# Since IEX1 started from AM x=0 (no native K), every K in IOX1 came from Na.
# Reversing all K→Na restores the original Na population at the same sites.

print "STAGE11: x_target=${x_target} r=${r} — all K (type 5) reverted to Na (type 4)"

set             type 5 type 4
set             type 4 charge 0.6000

################################################################################
# 2. NVT 4000 ps at 723 K — local rearrangement at fixed volume
################################################################################

timestep        ${dt}
thermo          10000
thermo_style    custom step time temp press pe etotal vol density
thermo_modify   norm no

velocity        all create 723.0 ${seed_vel} rot yes mom yes dist gaussian

dump            NVT all custom ${dump_nvt} &
                trajectories/REIEX1_NVT_723K_xt${x_target}_r${r}_PMMCS_rc8p0.lammpstrj &
                id type q x y z
dump_modify     NVT sort id element Si O Ca Na K first yes

fix             NVT all nvt temp 723.0 723.0 0.1
run             4000000
unfix           NVT
undump          NVT

################################################################################
# 3. NPT 6000 ps at 723 K — full volume relaxation
################################################################################

dump            NPT all custom ${dump_npt} &
                trajectories/REIEX1_NPT_723K_xt${x_target}_r${r}_PMMCS_rc8p0.lammpstrj &
                id type q x y z
dump_modify     NPT sort id element Si O Ca Na K first yes

fix             NPT all npt temp 723.0 723.0 0.1 iso 0.0 0.0 1.0
run             6000000
unfix           NPT
undump          NPT

write_data      data/rev_iex1_723K/REIEX1_723K_xt${x_target}_r${r}_PMMCS_rc8p0.data nocoeff nofix

print "STAGE11 done: REIEX1 x_target=${x_target} r=${r} PMMCS rc8p0"
