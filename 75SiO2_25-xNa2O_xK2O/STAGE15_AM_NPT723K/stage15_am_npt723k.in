# STAGE15_AM_NPT723K — As-Melted glass equilibration at 723 K (PMMCS rc8p0)
#
# Starts from the single 723 K snapshot saved by STAGE1 (mid-quench).
# No ion exchange — pure structural equilibration of the AM reference glass.
#
# Protocol:
#   1. read_data  AsMelted_723K_x{x}_r{r}
#   2. NVT 1000 ps at 723 K — thermal equilibration at fixed volume (no dump)
#   3. NPT 1000 ps at 723 K — volume relaxation (11 frames, every 100 ps)
#   4. write_data  AM_NPT_723K_x{x}_r{r}
#
# Required -var:
#   val_x      composition index (0, 1, 3, 6, 9, 12, 15)
#   val_r      replica index (1, 2, 3)
#   potfile    path to PMMCS .mod file

echo            both
units           metal
dimension       3
boundary        p p p
atom_style      charge
atom_modify     map yes
newton          on

variable        x      equal ${val_x}
variable        r      equal ${val_r}
variable        dt     equal 0.001

variable        seed_vel equal 72300+v_x*100+v_r*10

variable        dump_npt equal round(100.0/v_dt)    # every 100 ps → 11 frames over 1000 ps

log logs/stage15_x${x}_r${r}_PMMCS_rc8p0.lammps

read_data       ../STAGE1_MELTQUENCH/data/asmelted_723K/AsMelted_723K_x${x}_r${r}_PMMCS_rc8p0.data

include         ${potfile}

neighbor        2.0 bin
neigh_modify    delay 0 check yes every 1

timestep        ${dt}
thermo          10000
thermo_style    custom step time temp press pe etotal vol density
thermo_modify   norm no

velocity        all create 723.0 ${seed_vel} rot yes mom yes dist gaussian

################################################################################
# 1. NVT 1000 ps at 723 K — equilibration, no dump
################################################################################

fix             NVT all nvt temp 723.0 723.0 0.1
run             1000000
unfix           NVT

################################################################################
# 2. NPT 1000 ps at 723 K — production, dump every 100 ps (11 frames)
################################################################################

dump            NPT all custom ${dump_npt} &
                trajectories/AM_NPT_723K_x${x}_r${r}_PMMCS_rc8p0.lammpstrj &
                id type q x y z
dump_modify     NPT sort id element Si O Ca Na K first yes

fix             NPT all npt temp 723.0 723.0 0.1 iso 0.0 0.0 1.0
run             1000000
unfix           NPT
undump          NPT

write_data      data/am_npt723K/AM_NPT_723K_x${x}_r${r}_PMMCS_rc8p0.data nocoeff nofix

print "STAGE15 done: AM NPT 723K x=${x} r=${r} PMMCS rc8p0"
