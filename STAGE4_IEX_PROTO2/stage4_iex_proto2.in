# STAGE4_IEX_PROTO2 — Ion-exchange Protocol 2, PMMCS rc8p0
#
# Starts from x_parent as-melted glass at 723 K.
# Replaces ALL Na (type 4) → K (type 5) — complete substitution.
# NO initial minimization — IEX stresses are preserved.
#
# Protocol:
#   1. read_data x_parent at 723 K
#   2. Instantaneous substitution: all Na → K (set type 4 type 5)
#   3. NVT 4000 ps at 723 K — local rearrangement, fixed volume (10 frames)
#   4. NPT 6000 ps at 723 K — full volume relaxation (10 frames)
#   5. write_data IOX2_723K
#
# Required -var:
#   val_x_parent   parent composition (0, 1, 3, 6, 9, 12)
#   val_r          replica index (1, 2, 3)
#   potfile        path to PMMCS .mod file

echo            both
units           metal
dimension       3
boundary        p p p
atom_style      charge
atom_modify     map yes
newton          on

variable        x_parent equal ${val_x_parent}
variable        r        equal ${val_r}
variable        dt       equal 0.001

variable        seed_vel equal 65000+v_x_parent*100+v_r*10

variable        dump_nvt equal round(400.0/v_dt)    # 10 frames over 4000 ps
variable        dump_npt equal round(600.0/v_dt)    # 10 frames over 6000 ps

shell mkdir -p data/iox2_723K logs trajectories

log logs/stage4_xp${x_parent}_r${r}_PMMCS_rc8p0.lammps

read_data       ../STAGE1_MELTQUENCH/data/asmelted_723K/AsMelted_723K_x${x_parent}_r${r}_PMMCS_rc8p0.data

include         ${potfile}

neighbor        2.0 bin
neigh_modify    delay 0 check yes every 1

################################################################################
# 1. Instantaneous substitution: ALL Na → K — no minimization
################################################################################

print "STAGE4: x_parent=${x_parent} r=${r} — all Na converted to K (PMMCS rc8p0)"

set             type 4 type 5
set             type 5 charge 0.6000

################################################################################
# 2. NVT 6000 ps at 723 K — local rearrangement at fixed volume
################################################################################

timestep        ${dt}
thermo          10000
thermo_style    custom step time temp press pe etotal vol density
thermo_modify   norm no

velocity        all create 723.0 ${seed_vel} rot yes mom yes dist gaussian

dump            NVT all custom ${dump_nvt} &
                trajectories/IOX2_NVT_723K_xp${x_parent}_r${r}_PMMCS_rc8p0.lammpstrj &
                id type q x y z
dump_modify     NVT sort id element Si O Ca Na K first yes

fix             NVT all nvt temp 723.0 723.0 0.1
run             4000000
unfix           NVT
undump          NVT

################################################################################
# 3. NPT 6000 ps at 723 K — full volume relaxation
################################################################################

dump            NPT all custom ${dump_npt} &
                trajectories/IOX2_NPT_723K_xp${x_parent}_r${r}_PMMCS_rc8p0.lammpstrj &
                id type q x y z
dump_modify     NPT sort id element Si O Ca Na K first yes

fix             NPT all npt temp 723.0 723.0 0.1 iso 0.0 0.0 1.0
run             6000000
unfix           NPT
undump          NPT

write_data      data/iox2_723K/IOX2_723K_xp${x_parent}_r${r}_PMMCS_rc8p0.data nocoeff nofix

print "STAGE4 done: IOX2 x_parent=${x_parent} r=${r} PMMCS rc8p0"
