# STAGE2 — PMMCS rc8p0 — reference minimize for elastic tensor (T=0 K)
# Variables from command line:
#   val_x    composition (0,1,3,6,9,12,15)
#   val_r    replica (1,2,3)
#   potfile  path to potential mod file

units           metal
boundary        p p p
atom_style      charge
atom_modify     map yes
newton          on

read_data       ../STAGE1_MELTQUENCH/data/asmelted_300K/AsMelted_300K_x${val_x}_r${val_r}_PMMCS_rc8p0.data

log             results/elastic_T0_ref_x${val_x}_r${val_r}.lammps

include         ${potfile}
neighbor        1.0 bin
neigh_modify    once no every 1 delay 0 check yes

thermo          10
thermo_style    custom step temp pe press pxx pyy pzz pxy pxz pyz vol lx ly lz
thermo_modify   norm no

min_style       cg
min_modify      dmax 1.0e-2 line quadratic

fix             BOXRELAX all box/relax aniso 0.0 vmax 0.001
minimize        0.0 1.0e-10 10000 100000
unfix           BOXRELAX

write_restart   results/restart.elastic_T0_x${val_x}_r${val_r}

print "$(pxx) $(pyy) $(pzz) $(pxy) $(pxz) $(pyz) $(lx) $(ly) $(lz)" &
      file results/elastic_T0_ref_x${val_x}_r${val_r}.txt screen yes

print "REFERENCE DONE x=${val_x} r=${val_r}  press=$(press) bar  lx=$(lx) ly=$(ly) lz=$(lz) Ang"
