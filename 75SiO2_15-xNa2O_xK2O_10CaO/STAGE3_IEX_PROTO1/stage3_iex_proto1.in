# STAGE3_IEX_PROTO1 — Ion-exchange Protocol 1, PMMCS rc8p0
#
# Starts from x=0 as-melted glass at 723 K.
# Replaces EXACTLY n_replace Na→K to reach x_target mol% K2O.
# NO initial minimization — IEX stresses are preserved.
#
# Protocol:
#   1. read_data x=0 at 723 K
#   2. Na→K partial substitution (type/subset, exact count, random selection)
#   3. NVT 4000 ps at 723 K — local rearrangement, fixed volume (10 frames)
#   4. NPT 6000 ps at 723 K — full volume relaxation (10 frames)
#   5. write_data IOX1_723K
#
# Required -var:
#   val_x_target   target K2O mol% (1, 3, 6, 9, 12, 15)
#   val_r          replica index (1, 2, 3)
#   potfile        path to PMMCS .mod file

echo            both
units           metal
dimension       3
boundary        p p p
atom_style      charge
atom_modify     map yes
newton          on

variable        x_target equal ${val_x_target}
variable        r        equal ${val_r}
variable        dt       equal 0.001

variable        seed_sub equal 77000+v_x_target*100+v_r*10
variable        seed_vel equal 55000+v_x_target*100+v_r*10

variable        dump_nvt equal round(400.0/v_dt)    # 10 frames over 4000 ps
variable        dump_npt equal round(600.0/v_dt)    # 10 frames over 6000 ps

shell mkdir -p data/iox1_723K logs trajectories

log logs/stage3_xt${x_target}_r${r}_PMMCS_rc8p0.lammps

read_data       ../STAGE1_MELTQUENCH/data/asmelted_723K/AsMelted_723K_x0_r${r}_PMMCS_rc8p0.data

include         ${potfile}

neighbor        2.0 bin
neigh_modify    delay 0 check yes every 1

################################################################################
# 1. Instantaneous Na→K substitution — no minimization
################################################################################

group           Na_group  type 4
variable        n_Na      equal count(Na_group)
variable        n_replace equal round(v_n_Na*v_x_target/15.0)

print "STAGE3: x_target=${x_target} r=${r} — replacing ${n_replace} of ${n_Na} Na with K"

set             group Na_group type/subset 5 ${n_replace} ${seed_sub}
set             type 5 charge 0.6000
group           Na_group delete

################################################################################
# 2. NVT 6000 ps at 723 K — local rearrangement at fixed volume
################################################################################

timestep        ${dt}
thermo          10000
thermo_style    custom step time temp press pe etotal vol density
thermo_modify   norm no

velocity        all create 723.0 ${seed_vel} rot yes mom yes dist gaussian

dump            NVT all custom ${dump_nvt} &
                trajectories/IOX1_NVT_723K_xt${x_target}_r${r}_PMMCS_rc8p0.lammpstrj &
                id type q x y z
dump_modify     NVT sort id element Si O Ca Na K first yes

fix             NVT all nvt temp 723.0 723.0 0.1
run             4000000
unfix           NVT
undump          NVT

################################################################################
# 3. NPT 6000 ps at 723 K — full volume relaxation
################################################################################

dump            NPT all custom ${dump_npt} &
                trajectories/IOX1_NPT_723K_xt${x_target}_r${r}_PMMCS_rc8p0.lammpstrj &
                id type q x y z
dump_modify     NPT sort id element Si O Ca Na K first yes

fix             NPT all npt temp 723.0 723.0 0.1 iso 0.0 0.0 1.0
run             6000000
unfix           NPT
undump          NPT

write_data      data/iox1_723K/IOX1_723K_xt${x_target}_r${r}_PMMCS_rc8p0.data nocoeff nofix

print "STAGE3 done: IOX1 x_target=${x_target} r=${r} PMMCS rc8p0"
