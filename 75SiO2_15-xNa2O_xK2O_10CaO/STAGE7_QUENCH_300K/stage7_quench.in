# STAGE7 — PMMCS rc8p0 — Quench 723K → 300K at 1K/ps  (no minimization)
# Input variables (command line):
#   val_datafile   full path to input .data file at 723K
#   val_tag        unique run ID (e.g. AM_x6_r2, IEX1_xt3_r1, IEX2_xp0_r3)
#   val_outfile    full path to output .data file at 300K
#   potfile        path to potential mod file

units           metal
boundary        p p p
atom_style      charge
atom_modify     map yes
newton          on

read_data       ${val_datafile}

log             logs/stage7_${val_tag}.lammps

include         ${potfile}
neighbor        1.0 bin
neigh_modify    once no every 1 delay 0 check yes

thermo          10000
thermo_style    custom step time temp press pe etotal vol density
thermo_modify   norm no

timestep        0.001

# Quench 723→300K at 1K/ps: (723-300)/1 = 423 ps = 423000 steps
fix QUENCH all npt temp 723.0 300.0 0.1 iso 0.0 0.0 1.0
run             423000
unfix QUENCH

write_data      ${val_outfile} nocoeff nofix
print "DONE ${val_tag}: T=$(temp) K  press=$(press) bar  vol=$(vol) Ang3"
