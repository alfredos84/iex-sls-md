# STAGE12_REVERSE_IEX2 — Reverse Ion-exchange of Proto2, PMMCS rc8p0
#
# Tests whether IEX Proto2 is elastic: if the glass returns to the
# as-melted (x_parent) structure after re-substituting K→Na at the
# same sites that were originally occupied by Na.
#
# IEX Proto2 (STAGE4) converts ALL Na→K in AM_x{parent}.
# After IEX2, every atom is K — but only a subset came from Na.
# The parent AM glass may already contain native K (for x_parent > 0).
#
# Identification strategy (atom IDs preserved by LAMMPS set commands):
#   • extract_na_ids.py reads AM_x{parent} and records all Na atom IDs
#   • Those same atom IDs are now K (type 5) in IOX2
#   • This stage re-converts only THOSE K atoms back to Na
#   • Native K (originally type 5 in AM) is left unchanged
#
# Result after reverse:
#   x_parent=0  → 1500 Na,  0 K  (returns to AM x=0)
#   x_parent=1  → 1400 Na,100 K  (returns to AM x=1)
#   x_parent=3  → 1200 Na,300 K  (returns to AM x=3)
#   x_parent=6  →  900 Na,600 K  (returns to AM x=6)
#   x_parent=9  →  600 Na,900 K  (returns to AM x=9)
#   x_parent=12 →  300 Na,1200 K (returns to AM x=12)
#
# PREREQUISITE: run extract_na_ids.py BEFORE submitting this job.
#   python3 extract_na_ids.py ${x_parent} ${r}
#   → id_files/na_ids_xp{x_parent}_r{r}.lmp
#
# Protocol (mirrors STAGE4):
#   1. read_data IOX2_723K
#   2. Load Na-ID group from include file (generated by extract_na_ids.py)
#   3. K→Na selective back-substitution for former_Na group — no minimization
#   4. NVT 4000 ps at 723 K — local rearrangement at fixed volume (10 frames)
#   5. NPT 6000 ps at 723 K — full volume relaxation (10 frames)
#   6. write_data REIEX2_723K
#
# Required -var:
#   val_x_parent   parent composition used in STAGE4 (0, 1, 3, 6, 9, 12)
#   val_r          replica index (1, 2, 3)
#   potfile        path to PMMCS .mod file

echo            both
units           metal
dimension       3
boundary        p p p
atom_style      charge
atom_modify     map yes
newton          on

variable        x_parent equal ${val_x_parent}
variable        r        equal ${val_r}
variable        dt       equal 0.001

variable        seed_vel equal 95000+v_x_parent*100+v_r*10

variable        dump_nvt equal round(400.0/v_dt)    # 10 frames over 4000 ps
variable        dump_npt equal round(600.0/v_dt)    # 10 frames over 6000 ps

shell mkdir -p data/rev_iex2_723K logs trajectories

log logs/stage12_xp${x_parent}_r${r}_PMMCS_rc8p0.lammps

read_data       ../STAGE4_IEX_PROTO2/data/iox2_723K/IOX2_723K_xp${x_parent}_r${r}_PMMCS_rc8p0.data

include         ${potfile}

neighbor        2.0 bin
neigh_modify    delay 0 check yes every 1

################################################################################
# 1. Load the group of K atoms that came from Na
################################################################################

# The include file defines:  group former_Na id <atom IDs>
# These are the K (type 5) atoms whose IDs were Na (type 4) in AM_x{parent}.
# Generated by:  python3 extract_na_ids.py ${x_parent} ${r}

include         id_files/na_ids_xp${x_parent}_r${r}.lmp

print "STAGE12: x_parent=${x_parent} r=${r} — selective K→Na back-substitution (PMMCS rc8p0)"

################################################################################
# 2. Instantaneous selective K→Na back-substitution — no minimization
################################################################################

set             group former_Na type 4
set             group former_Na charge 0.6000

group           former_Na delete

################################################################################
# 3. NVT 4000 ps at 723 K — local rearrangement at fixed volume
################################################################################

timestep        ${dt}
thermo          10000
thermo_style    custom step time temp press pe etotal vol density
thermo_modify   norm no

velocity        all create 723.0 ${seed_vel} rot yes mom yes dist gaussian

dump            NVT all custom ${dump_nvt} &
                trajectories/REIEX2_NVT_723K_xp${x_parent}_r${r}_PMMCS_rc8p0.lammpstrj &
                id type q x y z
dump_modify     NVT sort id element Si O Ca Na K first yes

fix             NVT all nvt temp 723.0 723.0 0.1
run             4000000
unfix           NVT
undump          NVT

################################################################################
# 4. NPT 6000 ps at 723 K — full volume relaxation
################################################################################

dump            NPT all custom ${dump_npt} &
                trajectories/REIEX2_NPT_723K_xp${x_parent}_r${r}_PMMCS_rc8p0.lammpstrj &
                id type q x y z
dump_modify     NPT sort id element Si O Ca Na K first yes

fix             NPT all npt temp 723.0 723.0 0.1 iso 0.0 0.0 1.0
run             6000000
unfix           NPT
undump          NPT

write_data      data/rev_iex2_723K/REIEX2_723K_xp${x_parent}_r${r}_PMMCS_rc8p0.data nocoeff nofix

print "STAGE12 done: REIEX2 x_parent=${x_parent} r=${r} PMMCS rc8p0"
